# Docker Compose 使用；本地直接运行 Go 时，请通过终端设置环境变量。
# 正式版本推荐填写固定版本标签；dev 为主分支开发版，latest 仅由正式版本更新。
QPIX_IMAGE=ghcr.io/qwerto107/qpix:latest
QPIX_ADMIN_USERNAME=admin
# 首次启动前必须填写非空密码，最多 72 字节；不强制长度或复杂度，不提供默认密码。
QPIX_ADMIN_PASSWORD=
QPIX_DB_DRIVER=sqlite
QPIX_DB_DSN=/data/qpix.db
QPIX_STORAGE_ROOT=/data/uploads
# S3 凭据的独立加密密钥，首次启动自动创建，必须随数据库备份。
QPIX_MASTER_KEY_FILE=/data/master.key
# 仅填写实际反向代理的 IP/CIDR，多个用逗号分隔。留空不信任转发头。
QPIX_TRUSTED_PROXIES=
# 应急恢复管理访问用；正常保持 false。
QPIX_DISABLE_ACCESS_RULES=false
# 未在控制面板保存过上传上限时采用此启动默认值；面板保存后以数据库配置为准。
QPIX_MAX_UPLOAD_MB=20
# 生产 HTTPS 环境设置为 true。
QPIX_SECURE_COOKIE=false
# 管理页面的完整源地址，例如 https://qpix.example.com，本地 HTTP 可留空。
QPIX_APP_URL=
# 图片域名，例如 https://img.example.com；留空时返回当前站点的相对地址。
QPIX_PUBLIC_URL=
QPIX_WEB_PORT=8090
